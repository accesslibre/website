{
  "name": "iatf-website",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "check": "npm run build",
    "dev": "node --watch-path=build --watch-path=content --watch-path=data --watch-path=client --watch-path=assets build/build.mjs --dev-fast",
    "dev:full": "node --watch-path=build --watch-path=content --watch-path=data --watch-path=client --watch-path=assets build/build.mjs",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:site": "node scripts/build-public-site.mjs",
    "dev:site": "wrangler dev --config wrangler.libreaccessibility.jsonc",
    "test:site": "node --test tests/site-migration.test.mjs tests/proposal-intake.test.mjs",
    "deploy:site": "npm run build:site && wrangler deploy --config wrangler.libreaccessibility.jsonc"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
